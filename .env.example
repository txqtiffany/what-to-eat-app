# Copy this file to `.env.local` and fill in real values from the
# Firebase console > Project settings > General > Your apps > Web app SDK config.
# Vite reads .env.local automatically and the values are inlined at build time
# via vite.config.ts.

# Already used by the existing Gemini integration:
GEMINI_API_KEY=

# Firebase web app config:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
