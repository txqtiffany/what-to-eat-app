rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Recipe images live at dishes/{dishId}/{file}.
    // Anyone signed in can read (the Firestore rules guard which dishes you
    // can list anyway). Writes require sign-in; per-dish ownership is
    // enforced in Firestore — Storage just stops random anonymous writes.
    match /dishes/{dishId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Optional future area: per-user profile photos.
    match /users/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
