rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ----- users -----
    match /users/{uid} {
      // Anyone signed in can read another user's profile (displayName, photo).
      // We don't store anything sensitive here.
      allow read: if isSignedIn();
      allow create: if isMe(uid);
      allow update: if isMe(uid);
      allow delete: if false;
    }

    // ----- folders -----
    match /folders/{folderId} {
      function folder() { return resource.data; }

      allow read: if folder().visibility == 'public-link'
                  || (isSignedIn() && request.auth.uid in folder().memberUids);

      allow create: if isSignedIn()
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;

      // Only the creator can change folder settings/membership.
      allow update: if isSignedIn()
                    && resource.data.creatorUid == request.auth.uid;

      allow delete: if isSignedIn()
                    && resource.data.creatorUid == request.auth.uid;
    }

    // ----- dishes -----
    match /dishes/{dishId} {
      function dishFolder() {
        return get(/databases/$(database)/documents/folders/$(resource.data.folderId)).data;
      }
      function newDishFolder() {
        return get(/databases/$(database)/documents/folders/$(request.resource.data.folderId)).data;
      }

      // Owners can always read their own dishes (this is what makes the
      // ownerUid==me list query provably-safe). Others can read if the dish's
      // folder is public-link or they're a folder member.
      allow read: if (isSignedIn() && resource.data.ownerUid == request.auth.uid)
                  || dishFolder().visibility == 'public-link'
                  || (isSignedIn() && request.auth.uid in dishFolder().memberUids);

      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in newDishFolder().memberUids;

      // Only the dish owner can edit/delete their own dish, even inside a
      // shared folder. This stops other members from clobbering each other.
      allow update, delete: if isSignedIn()
                            && resource.data.ownerUid == request.auth.uid;
    }

    // ----- likes (composite-id docs: {uid}_{dishId}) -----
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // ----- invites -----
    match /invites/{inviteId} {
      allow read: if isSignedIn()
                  && (resource.data.inviterUid == request.auth.uid
                      || resource.data.inviteeEmail == request.auth.token.email);

      allow create: if isSignedIn()
                    && request.resource.data.inviterUid == request.auth.uid;

      // Inviter can revoke; invitee can mark accepted.
      allow update: if isSignedIn()
                    && (resource.data.inviterUid == request.auth.uid
                        || resource.data.inviteeEmail == request.auth.token.email);

      allow delete: if isSignedIn()
                    && resource.data.inviterUid == request.auth.uid;
    }

  }
}
